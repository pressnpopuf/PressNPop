        <div class="rubrik">

            <span>PressN'Pop UF</span>

            <h2>Kontakta oss</h2>

            <p>
                Har du frågor eller vill du beställa?
                Hör gärna av dig!
            </p>

        </div>


        <p>
            Instagram:
            <a href="#">
                @pressnpop_uf
            </a>
        </p>


        <p>
            E-post:
            <a href="mailto:pressnpop.uf@gmail.com">
                pressnpop.uf@gmail.com
            </a>
        </p>

    </section>



    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <img
            src="bilder/logo.png"
            alt="PressN'Pop logotyp"
            class="footer-logo"
        >

        <p>
            PressN'Pop UF
        </p>

        <p>
            Handgjorda press-on naglar ♡
        </p>

        <p>
            © 2026 PressN'Pop
        </p>

    </footer>


</body>

</html>
