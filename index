    <script>

        /* =====================================================
           BESTÄLLNING
        ===================================================== */

        let orderData = {
            design: "",
            size: ""
        };


        function openOrder(design) {

            orderData.design = design;

            document.getElementById("orderModal").classList.add("active");

            showOrderStep(1);

            if (design) {

                const options = document.querySelectorAll(
                    "#orderStep1 .option"
                );

                options.forEach(option => {

                    option.classList.remove("selected");

                    if (option.textContent.trim() === design) {
                        option.classList.add("selected");
                    }

                });

            }

        }


        function closeModal(id) {

            document.getElementById(id).classList.remove("active");

        }


        function selectOrderOption(element, type, value) {

            const parent = element.parentElement;

            parent.querySelectorAll(".option").forEach(option => {
                option.classList.remove("selected");
            });

            element.classList.add("selected");

            orderData[type] = value;

        }


        function showOrderStep(number) {

            document
                .querySelectorAll("#orderModal .step")
                .forEach(step => step.classList.remove("active"));

            document
                .getElementById("orderStep" + number)
                .classList.add("active");


            document
                .querySelectorAll(".order-progress")
                .forEach((bar, index) => {

                    bar.classList.toggle(
                        "active",
                        index < number
                    );

                });


            if (number === 3) {

                document.getElementById("orderSummary").innerHTML = `
                    <strong>Din beställning</strong>
                    <p>Design: ${orderData.design || "Inte vald"}</p>
                    <p>Storlek: ${orderData.size || "Inte vald"}</p>
                `;

            }

        }


        function nextOrderStep(number) {

            if (number === 2 && !orderData.design) {

                alert("Välj en design först ♡");
                return;

            }

            if (number === 3 && !orderData.size) {

                alert("Välj en storlek först ♡");
                return;

            }

            showOrderStep(number);

        }


        function submitOrder() {

            const name =
                document.getElementById("orderName").value.trim();

            const email =
                document.getElementById("orderEmail").value.trim();

            const message =
                document.getElementById("orderMessage").value.trim();


            if (!name || !email) {

                alert("Fyll i ditt namn och din e-post ♡");
                return;

            }


            /*
                Detta öppnar kundens e-postprogram och
                förbereder en riktig beställning till er.
            */

            const subject =
                "Ny beställning – PressN'Pop UF";

            const body =
                `Hej PressN'Pop!

Jag vill beställa:

Design: ${orderData.design}
Storlek: ${orderData.size}

Namn: ${name}
E-post: ${email}

Meddelande:
${message || "Inget meddelande."}

Skickat via PressN'Pop hemsida.`;


            window.location.href =
                "mailto:pressnpop.uf@gmail.com" +
                "?subject=" +
                encodeURIComponent(subject) +
                "&body=" +
                encodeURIComponent(body);


            document
                .querySelectorAll("#orderModal .step")
                .forEach(step => step.classList.remove("active"));

            document
                .getElementById("orderSuccess")
                .classList.add("active");

        }



        /* =====================================================
           CUSTOM
        ===================================================== */

        let customData = {
            form: "",
            length: ""
        };


        function openCustom() {

            document
                .getElementById("customModal")
                .classList.add("active");

            showCustomStep(1);

        }


        function selectCustom(element, type, value) {

            const parent = element.parentElement;

            parent.querySelectorAll(".option").forEach(option => {
                option.classList.remove("selected");
            });

            element.classList.add("selected");

            customData[type] = value;

        }


        function showCustomStep(number) {

            document
                .querySelectorAll("#customModal .step")
                .forEach(step => step.classList.remove("active"));

            document
                .getElementById("customStep" + number)
                .classList.add("active");


            document
                .querySelectorAll(".custom-progress")
                .forEach((bar, index) => {

                    bar.classList.toggle(
                        "active",
                        index < number
                    );

                });


            if (number === 4) {

                const color =
                    document.getElementById("customColor").value;

                const design =
                    document.getElementById("customDesign").value;

                const extra =
                    document.getElementById("customExtra").value;


                document.getElementById("customSummary").innerHTML = `

                    <strong>Din custom-design</strong>

                    <p>
                        Form: ${customData.form || "Inte vald"}
                    </p>

                    <p>
                        Längd: ${customData.length || "Inte vald"}
                    </p>

                    <p>
                        Färg: ${color || "Inte angiven"}
                    </p>

                    <p>
                        Design: ${design || "Inte angiven"}
                    </p>

                    <p>
                        Övrigt: ${extra || "Inget"}
                    </p>

                `;

            }

        }


        function nextCustomStep(number) {

            if (number === 2 && !customData.form) {

                alert("Välj en nagelform först ♡");
                return;

            }

            if (number === 3 && !customData.length) {

                alert("Välj en längd först ♡");
                return;

            }

            if (number === 4) {

                const color =
                    document.getElementById("customColor").value.trim();

                const design =
                    document.getElementById("customDesign").value.trim();

                if (!color || !design) {

                    alert(
                        "Skriv gärna vilken färg och design du vill ha ♡"
                    );

                    return;

                }

            }

            showCustomStep(number);

        }


        function submitCustom() {

            const name =
                document.getElementById("customName").value.trim();

            const email =
                document.getElementById("customEmail").value.trim();

            const color =
                document.getElementById("customColor").value.trim();

            const design =
                document.getElementById("customDesign").value.trim();

            const extra =
                document.getElementById("customExtra").value.trim();


            if (!name || !email) {

                alert("Fyll i ditt namn och din e-post ♡");
                return;

            }


            const subject =
                "Custom nails – PressN'Pop UF";


            const body =
                `Hej PressN'Pop!

Jag vill skapa ett custom set.

Form: ${customData.form}
Längd: ${customData.length}
Färg: ${color}
Design: ${design}
Övrigt: ${extra || "Inget"}

Namn: ${name}
E-post: ${email}

Skickat via PressN'Pop hemsida.`;


            window.location.href =
                "mailto:pressnpop.uf@gmail.com" +
                "?subject=" +
                encodeURIComponent(subject) +
                "&body=" +
                encodeURIComponent(body);


            document
                .querySelectorAll("#customModal .step")
                .forEach(step => step.classList.remove("active"));

            document
                .getElementById("customSuccess")
                .classList.add("active");

        }



        /* =====================================================
           STÄNG MODAL OM MAN KLICKAR UTANFÖR
        ===================================================== */

        window.addEventListener("click", function(event) {

            const orderModal =
                document.getElementById("orderModal");

            const customModal =
                document.getElementById("customModal");


            if (event.target === orderModal) {
                closeModal("orderModal");
            }

            if (event.target === customModal) {
                closeModal("customModal");
            }

        });


    </script>


</body>

</html>
