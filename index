<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PressN'Pop UF | Press-on Nails</title>

    <!-- FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Dancing+Script:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">


    <style>

        /* =====================================================
           GRUND
        ===================================================== */

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Poppins", sans-serif;
            background: #fffaf8;
            color: #333;
            overflow-x: hidden;
        }

        :root {
            --rosa: #d98aa4;
            --morkrosa: #ad5574;
            --ljusrosa: #f9e5eb;
            --cream: #fffaf5;
            --guld: #c5a05a;
            --morkguld: #a88442;
            --text: #333;
            --vit: #ffffff;
        }

        h1,
        h2,
        h3 {
            font-family: "Dancing Script", cursive;
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           HIBISKUS / DEKORATION
        ===================================================== */

        .blomma {
            position: absolute;
            font-size: 95px;
            color: rgba(217, 138, 164, 0.16);
            pointer-events: none;
            user-select: none;
        }

        .blomma.guld {
            color: rgba(197, 160, 90, 0.16);
        }

        .blomma-1 {
            top: 90px;
            left: 3%;
            transform: rotate(-20deg);
        }

        .blomma-2 {
            bottom: 30px;
            right: 3%;
            transform: rotate(20deg);
        }

        .blomma-3 {
            top: 20px;
            right: 7%;
            font-size: 65px;
            transform: rotate(15deg);
        }


        /* =====================================================
           NAVIGATION
        ===================================================== */

        nav {
            height: 82px;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(12px);

            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 10px 6%;

            position: sticky;
            top: 0;
            z-index: 1000;

            border-bottom: 1px solid rgba(197, 160, 90, 0.15);
        }

        .logo-link {
            display: flex;
            align-items: center;
        }

        .logo {
            width: 70px;
            height: 60px;
            object-fit: contain;
            transition: 0.3s;
        }

        .logo:hover {
            transform: scale(1.06);
        }

        .meny {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .meny a {
            color: #333;
            font-size: 14px;
            transition: 0.3s;
        }

        .meny a:hover {
            color: var(--morkrosa);
        }

        .bestall-knapp {
            background: var(--rosa);
            color: white !important;
            padding: 11px 22px;
            border-radius: 30px;
            box-shadow: 0 5px 15px rgba(173, 85, 116, 0.2);
        }

        .bestall-knapp:hover {
            background: var(--morkrosa);
            transform: translateY(-2px);
        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            min-height: 680px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 80px 9%;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(circle at 8% 20%, #f6d7e1 0, transparent 24%),
                radial-gradient(circle at 90% 85%, #f5e0d3 0, transparent 25%),
                #fffaf6;
        }

        .hero-text {
            max-width: 610px;
            position: relative;
            z-index: 2;
        }

        .liten-text {
            color: var(--guld);
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 12px;
            margin-bottom: 15px;
            font-weight: 500;
        }

        .hero-text h1 {
            color: var(--morkrosa);
            font-size: 82px;
            line-height: 0.95;
            margin-bottom: 8px;
        }

        .hero-text h2 {
            color: #555;
            font-size: 34px;
            font-weight: 500;
            margin-bottom: 25px;
        }

        .hero-text p {
            color: #666;
            font-size: 17px;
            line-height: 1.8;
            max-width: 540px;
            margin-bottom: 30px;
        }

        .knapp {
            display: inline-block;
            background: var(--rosa);
            color: white;
            padding: 14px 27px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.3s;
            box-shadow: 0 7px 20px rgba(173, 85, 116, 0.2);
            border: none;
            cursor: pointer;
        }

        .knapp:hover {
            background: var(--morkrosa);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(173, 85, 116, 0.3);
        }

        .knapp-outline {
            background: transparent;
            color: var(--morkrosa);
            border: 1px solid var(--rosa);
            box-shadow: none;
            margin-left: 10px;
        }

        .knapp-outline:hover {
            background: var(--ljusrosa);
            color: var(--morkrosa);
        }


        /* HERO BLOMMA */

        .hero-blomma {
            position: absolute;
            right: 45%;
            bottom: 5%;
            font-size: 80px;
            color: rgba(197, 160, 90, 0.18);
            transform: rotate(-15deg);
        }


        /* HERO CIRCLE */

        .hero-logo {
            width: 420px;
            height: 420px;

            border-radius: 50%;
            background:
                radial-gradient(circle, #fff 0%, #fbe9ee 60%, #f4d4df 100%);

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            box-shadow:
                0 25px 55px rgba(80, 40, 50, 0.12);

            border: 1px solid rgba(197, 160, 90, 0.35);
        }

        .hero-logo::before {
            content: "";
            position: absolute;
            width: 370px;
            height: 370px;
            border: 1px solid rgba(197, 160, 90, 0.35);
            border-radius: 50%;
        }

        .hero-logo img {
            width: 76%;
            height: 76%;
            object-fit: contain;
            position: relative;
            z-index: 2;
        }

        .hero-decoration {
            position: absolute;
            color: var(--guld);
            font-size: 23px;
            z-index: 3;
        }

        .hero-decoration.one {
            top: 50px;
            right: 75px;
        }

        .hero-decoration.two {
            bottom: 50px;
            left: 65px;
        }


        /* =====================================================
           SEKTIONER
        ===================================================== */

        section {
            padding: 100px 8%;
            position: relative;
            overflow: hidden;
        }

        .rubrik {
            text-align: center;
            margin-bottom: 45px;
            position: relative;
            z-index: 2;
        }

        .rubrik span {
            color: var(--guld);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 12px;
        }

        .rubrik h2 {
            color: var(--morkrosa);
            font-size: 55px;
            margin-top: 5px;
            margin-bottom: 10px;
        }

        .rubrik p {
            color: #777;
            font-size: 16px;
        }


        /* =====================================================
           DESIGNS
        ===================================================== */

        .design-section {
            background: #fffaf8;
        }

        .design-scroll-wrapper {
            position: relative;
        }

        .naglar {
            display: flex;
            gap: 25px;

            overflow-x: auto;
            overflow-y: hidden;

            padding: 10px 5px 25px;

            scroll-behavior: smooth;

            scrollbar-width: thin;
            scrollbar-color: var(--rosa) #f8e8ed;
        }

        .naglar::-webkit-scrollbar {
            height: 7px;
        }

        .naglar::-webkit-scrollbar-track {
            background: #f8e8ed;
            border-radius: 10px;
        }

        .naglar::-webkit-scrollbar-thumb {
            background: var(--rosa);
            border-radius: 10px;
        }

        .nagel-kort {
            flex: 0 0 290px;

            background: white;
            border-radius: 25px;
            overflow: hidden;

            border: 1px solid #f0dbe2;

            box-shadow: 0 8px 25px rgba(60, 30, 40, 0.07);

            transition: 0.35s;
        }

        .nagel-kort:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(60, 30, 40, 0.12);
        }

        .nagel-bild {
            height: 300px;
            background:
                radial-gradient(circle at 30% 30%, #f7d7e1, transparent 30%),
                radial-gradient(circle at 70% 70%, #ead1bb, transparent 30%),
                #f8e9ed;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;
            overflow: hidden;
        }

        .nagel-bild::after {
            content: "✿";
            position: absolute;
            font-size: 110px;
            color: rgba(173, 85, 116, 0.13);
            transform: rotate(-20deg);
        }

        .nagel-bild img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: relative;
            z-index: 2;
        }

        .nagel-info {
            padding: 22px;
            text-align: center;
        }

        .nagel-info h3 {
            color: var(--morkrosa);
            font-size: 30px;
            margin-bottom: 8px;
        }

        .nagel-info p {
            color: #777;
            font-size: 14px;
            line-height: 1.6;
            min-height: 45px;
            margin-bottom: 17px;
        }

        .scroll-hint {
            text-align: center;
            color: #999;
            font-size: 12px;
            margin-top: 10px;
        }

        .scroll-hint span {
            color: var(--guld);
            font-size: 17px;
        }


        /* =====================================================
           CUSTOM
        ===================================================== */

        .custom {
            background:
                radial-gradient(circle at 90% 20%, #f3d2dd 0, transparent 27%),
                #fbecef;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 60px;
        }

        .custom-text {
            max-width: 600px;
            z-index: 2;
        }

        .guld-symbol {
            color: var(--guld);
            font-size: 24px;
            margin-bottom: 10px;
        }

        .custom-text h2 {
            color: var(--morkrosa);
            font-size: 54px;
            line-height: 1.05;
            margin-bottom: 20px;
        }

        .custom-text p {
            color: #666;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .custom-bild {
            width: 390px;
            height: 390px;

            background: white;
            border-radius: 50%;
            padding: 14px;

            box-shadow: 0 20px 40px rgba(80, 40, 50, 0.12);

            position: relative;
            z-index: 2;
        }

        .custom-bild img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }


        /* =====================================================
           ABOUT US
        ===================================================== */

        .about-section {
            background: #fffaf8;
        }

        .about-content {
            max-width: 950px;
            margin: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-text h2 {
            color: var(--morkrosa);
            font-size: 55px;
            margin-bottom: 18px;
        }

        .about-text p {
            color: #666;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .founders {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .founder {
            background: #fbecef;
            padding: 15px 20px;
            border-radius: 20px;
            border: 1px solid #f0d6df;
        }

        .founder strong {
            display: block;
            color: var(--morkrosa);
            font-family: "Dancing Script", cursive;
            font-size: 25px;
        }

        .founder span {
            font-size: 12px;
            color: #888;
        }

        .about-card {
            background:
                radial-gradient(circle at 20% 20%, #f5d9e1, transparent 25%),
                #fff;

            border-radius: 35px;
            padding: 45px 35px;
            text-align: center;

            border: 1px solid #f0dce1;

            box-shadow: 0 15px 35px rgba(70, 35, 45, 0.07);
        }

        .about-card .big-flower {
            font-size: 75px;
            color: var(--rosa);
            margin-bottom: 15px;
        }

        .about-card h3 {
            color: var(--morkrosa);
            font-size: 36px;
            margin-bottom: 12px;
        }

        .about-card p {
            color: #777;
            line-height: 1.7;
            font-size: 14px;
        }


        /* =====================================================
           BESTÄLLNING
        ===================================================== */

        .bestallning {
            text-align: center;

            background:
                radial-gradient(circle at 15% 30%, #f4d8e1, transparent 25%),
                radial-gradient(circle at 85% 70%, #f1dfd0, transparent 25%),
                #fff3f6;

            border-top: 1px solid #f0d9df;
            border-bottom: 1px solid #f0d9df;
        }

        .bestallning h2 {
            color: var(--morkrosa);
            font-size: 57px;
            margin-bottom: 15px;
        }

        .bestallning p {
            max-width: 650px;
            margin: 0 auto 30px;
            color: #666;
            line-height: 1.8;
        }


        /* =====================================================
           SOCIALS / KONTAKT
        ===================================================== */

        .kontakt {
            text-align: center;
        }

        .socials {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 35px;
            flex-wrap: wrap;
        }

        .social-card {
            width: 210px;
            padding: 25px;
            background: white;
            border: 1px solid #f0dce2;
            border-radius: 25px;
            transition: 0.3s;
            box-shadow: 0 7px 20px rgba(70, 35, 45, 0.05);
        }

        .social-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(70, 35, 45, 0.1);
        }

        .social-card .icon {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .social-card h3 {
            color: var(--morkrosa);
            font-size: 27px;
        }

        .social-card p {
            color: #888;
            font-size: 13px;
        }

        .email {
            margin-top: 30px;
            color: var(--morkrosa);
            font-weight: 500;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            background: #ad5574;
            color: white;
            text-align: center;
            padding: 45px 20px;
            position: relative;
            overflow: hidden;
        }

        footer::before {
            content: "✿";
            position: absolute;
            left: 5%;
            top: 5px;
            font-size: 100px;
            color: rgba(255,255,255,0.08);
        }

        footer::after {
            content: "✿";
            position: absolute;
            right: 5%;
            bottom: -20px;
            font-size: 100px;
            color: rgba(255,255,255,0.08);
        }

        .footer-logo {
            width: 75px;
            height: 75px;
            object-fit: contain;
            background: white;
            border-radius: 50%;
            padding: 5px;
            margin-bottom: 15px;
        }

        footer p {
            margin: 6px;
            font-size: 13px;
        }

        footer .footer-small {
            opacity: 0.75;
            margin-top: 18px;
        }


        /* =====================================================
           MODAL / BESTÄLLNINGSFORMULÄR
        ===================================================== */

        .modal {
            display: none;

            position: fixed;
            inset: 0;

            background: rgba(45, 20, 30, 0.55);
            backdrop-filter: blur(6px);

            z-index: 3000;

            align-items: center;
            justify-content: center;

            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-box {
            background: #fffaf8;
            width: 100%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;

            border-radius: 30px;
            padding: 35px;

            position: relative;

            box-shadow: 0 25px 70px rgba(0,0,0,0.2);
        }

        .close {
            position: absolute;
            right: 22px;
            top: 18px;

            border: none;
            background: none;

            font-size: 28px;
            color: #888;

            cursor: pointer;
        }

        .modal-box h2 {
            color: var(--morkrosa);
            font-size: 45px;
            margin-bottom: 5px;
        }

        .modal-subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .step {
            display: none;
        }

        .step.active {
            display: block;
        }

        .step-title {
            color: var(--morkrosa);
            font-size: 27px;
            font-family: "Dancing Script", cursive;
            margin-bottom: 18px;
        }

        .option-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 25px;
        }

        .option {
            padding: 16px;
            background: white;
            border: 1px solid #edd6de;
            border-radius: 15px;
            cursor: pointer;
            text-align: center;
            transition: 0.25s;
            color: #555;
            font-size: 14px;
        }

        .option:hover {
            border-color: var(--rosa);
            transform: translateY(-2px);
        }

        .option.selected {
            background: var(--ljusrosa);
            border: 2px solid var(--rosa);
            color: var(--morkrosa);
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            color: #555;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 13px 15px;
            border-radius: 13px;
            border: 1px solid #e6d3d9;
            background: white;
            font-family: "Poppins", sans-serif;
            outline: none;
        }

        .form-group textarea {
            min-height: 90px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: var(--rosa);
        }

        .step-buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 20px;
        }

        .progress {
            display: flex;
            gap: 7px;
            margin-bottom: 25px;
        }

        .progress span {
            height: 4px;
            flex: 1;
            background: #eadde1;
            border-radius: 10px;
        }

        .progress span.active {
            background: var(--rosa);
        }

        .summary {
            background: white;
            border: 1px solid #efdce2;
            padding: 20px;
            border-radius: 18px;
            margin: 20px 0;
        }

        .summary p {
            margin: 7px 0;
            color: #666;
            font-size: 14px;
        }

        .success {
            text-align: center;
            padding: 25px 5px;
        }

        .success .check {
            font-size: 60px;
            color: var(--rosa);
        }

        .success h2 {
            margin: 10px 0;
        }

        .success p {
            color: #777;
            line-height: 1.7;
        }


        /* =====================================================
           CUSTOM SELECT
        ===================================================== */

        #customModal .modal-box {
            max-width: 680px;
        }


        /* =====================================================
           MOBIL
        ===================================================== */

        @media (max-width: 850px) {

            nav {
                height: auto;
                padding: 10px 5%;
                gap: 8px;
            }

            .logo {
                width: 62px;
            }

            .meny {
                gap: 9px;
                flex-wrap: wrap;
                justify-content: flex-end;
            }

            .meny a {
                font-size: 11px;
            }

            .bestall-knapp {
                padding: 8px 13px;
            }

            .hero {
                flex-direction: column;
                text-align: center;
                gap: 50px;
                padding: 65px 7%;
            }

            .hero-text h1 {
                font-size: 62px;
            }

            .hero-text h2 {
                font-size: 28px;
            }

            .hero-text p {
                font-size: 15px;
            }

            .hero-logo {
                width: 310px;
                height: 310px;
            }

            .hero-logo::before {
                width: 275px;
                height: 275px;
            }

            section {
                padding: 75px 6%;
            }

            .rubrik h2,
            .bestallning h2 {
                font-size: 44px;
            }

            .custom {
                flex-direction: column;
                text-align: center;
            }

            .custom-text h2 {
                font-size: 45px;
            }

            .custom-bild {
                width: 300px;
                height: 300px;
            }

            .about-content {
                grid-template-columns: 1fr;
            }

            .about-text {
                text-align: center;
            }

            .founders {
                justify-content: center;
            }

            .modal-box {
                padding: 27px 20px;
            }

            .option-grid {
                grid-template-columns: 1fr 1fr;
            }

            .knapp-outline {
                margin-left: 0;
                margin-top: 10px;
            }
        }

        @media (max-width: 500px) {

            .hero-text h1 {
                font-size: 54px;
            }

            .meny a:not(.bestall-knapp) {
                display: none;
            }

            .nagel-kort {
                flex-basis: 260px;
            }

            .nagel-bild {
                height: 270px;
            }

            .modal-box h2 {
                font-size: 38px;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         NAVIGATION
    ===================================================== -->

    <nav>

        <a href="#hem" class="logo-link">

            <img
                src="bilder/logo.png"
                alt="PressN'Pop UF logotyp"
                class="logo"
            >

        </a>


        <div class="meny">

            <a href="#hem">Hem</a>

            <a href="#naglar">Naglar</a>

            <a href="#custom">Custom</a>

            <a href="#omoss">About us</a>

            <a href="#kontakt">Kontakt</a>

            <a href="#bestall" class="bestall-knapp">
                Beställ
            </a>

        </div>

    </nav>



    <!-- =====================================================
         HERO
    ===================================================== -->

    <section class="hero" id="hem">

        <div class="blomma blomma-1">✿</div>
        <div class="blomma blomma-2">✿</div>
        <div class="blomma guld blomma-3">✿</div>

        <div class="hero-text">

            <div class="liten-text">
                Handgjorda press-on nails · Eskilstuna
